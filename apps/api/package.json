{
  "name": "@casebridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "alerts:refresh": "tsx src/modules/alerts/refresh.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.3",
    "zod": "^4.1.13",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "vitest": "^4.0.14",
    "supertest": "^7.1.4",
    "@types/express": "^5.0.5",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/node": "^24.10.0"
  }
}
