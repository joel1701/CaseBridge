API_PORT=3001
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
# Not required for health checks. Supply before using Prisma commands.
DATABASE_URL=postgresql://casebridge:CHANGE_ME@localhost:5432/casebridge
# Generate: openssl rand -hex 32. Blank disables authentication; no default secret.
JWT_SECRET=
NODE_ENV=development
# Use none only for a genuinely cross-site HTTPS frontend/API pair; secure is automatic in production.
COOKIE_SAME_SITE=lax
# Optional synthetic seed user; omit to seed data only. No default password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
