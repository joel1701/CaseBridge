API_PORT=3001
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
# Not required for health checks. Supply before using Prisma commands.
DATABASE_URL=postgresql://casebridge:CHANGE_ME@localhost:5432/casebridge
# Generate: openssl rand -hex 32. Blank disables authentication; no default secret.
JWT_SECRET=
NODE_ENV=development
# Use none only for a genuinely cross-site HTTPS frontend/API pair; secure is automatic in production.
COOKIE_SAME_SITE=lax
# Optional synthetic seed user; omit to seed data only. No default password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Joel: same generated secret as apps/ai/.env. Never put this in Vite variables.
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=30000
# Development thresholds, not calibrated probabilities.
MATCH_THRESHOLD=0.55
MATCH_SEMANTIC_THRESHOLD=0.40
MATCH_CANDIDATE_LIMIT=100

# Deadline monitor lead time (1..720 hours); invoke alerts:refresh on your scheduler.
DEADLINE_ALERT_HOURS=48
# Optional demo account password; omit to generate private local credentials.
# SEED_DEMO_PASSWORD=
# Set only to the exact number of trusted reverse-proxy hops in your deployment.
TRUST_PROXY_HOPS=0
