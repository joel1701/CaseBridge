# Set the same generated secret in Express and here (openssl rand -hex 32).
AI_SERVICE_TOKEN=
EMBEDDING_MODE=transformer
# Optional immutable Hugging Face commit for reproducible evaluation.
MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# Defaults to apps/ai/.model-cache; no models downloaded during pip installation.
MODEL_CACHE_DIR=
ALLOW_MODEL_DOWNLOAD=false
PRELOAD_MODEL=false
