{
  "name": "casebridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @casebridge/web\" \"npm run dev -w @casebridge/api\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @casebridge/api",
    "db:generate": "npm run db:generate -w @casebridge/api",
    "db:validate": "npm run db:validate -w @casebridge/api",
    "db:migrate": "npm run db:migrate -w @casebridge/api",
    "db:deploy": "npm run db:deploy -w @casebridge/api",
    "db:seed": "npm run db:seed -w @casebridge/api",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.48.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
